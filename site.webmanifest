{
  "id": "https://examready-tool.vercel.app/",
  "name": "Photo Compressor - Exam Ready",
  "short_name": "PhotoCompress",
  "description": "Convert and resize photos to 20KB–50KB and signature to 10–20KB for SSC, UPSC and Sarkari exam forms.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#f8fafc",
  "theme_color": "#4f46e5",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities", "productivity", "photo"],
  "icons": [
    {
      "src": "/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Passport Photo (20-50KB)",
      "short_name": "Passport",
      "description": "Compress photo to 20KB-50KB",
      "url": "/?mode=passport",
      "icons": [{ "src": "/apple-touch-icon.png", "sizes": "180x180" }]
    },
    {
      "name": "Signature (10-20KB)",
      "short_name": "Signature",
      "description": "Compress signature to 10KB-20KB",
      "url": "/?mode=signature",
      "icons": [{ "src": "/apple-touch-icon.png", "sizes": "180x180" }]
    }
  ]
}
